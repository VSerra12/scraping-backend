# ── Entorno ────────────────────────────────────────────────
# "development" permite SECRET_KEY default (solo para pruebas locales)
# "production" la rechaza al inicio si no fue cambiada
ENV=production

# ── Base de datos ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/fashionsearch

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth admin ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_seguro
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Scraping ───────────────────────────────────────────────
SCRAPING_DELAY_MIN=1.0
SCRAPING_DELAY_MAX=2.0
MAX_PAGES_PER_STORE=20
SCRAPE_INTERVAL_HOURS=24

# ── IA ─────────────────────────────────────────────────────
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=500